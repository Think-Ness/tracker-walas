# Class Monitor — Environment Configuration
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API Key (from Google AI Studio: aistudio.google.com)
# Used server-side only — never exposed to browser
GEMINI_API_KEY=your_gemini_api_key
